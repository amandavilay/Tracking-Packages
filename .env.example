# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"

# Production database (Turso). Leave blank locally.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Your app's public URL, no trailing slash (http://localhost:3000 locally)
APP_URL="http://localhost:3000"

# Password you type to open the app
APP_PASSWORD=""

# Long random strings. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
CRON_SECRET=""

# Google OAuth (Gmail read only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 17TRACK
TRACK17_API_KEY=""

# Anthropic (Claude API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Web push. Generate with: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Emails processed per scan run (keeps each run under Vercel's time limit)
SCAN_BATCH="40"
